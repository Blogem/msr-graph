#
# GraphDB repository configuration for repository "msr" (MSR knowledge-graph POC).
#
# Vendored from GraphDB's own repository-configuration TTL template
# (RDF4J config vocabulary + the graphdb: extension properties), unchanged in
# structure across GraphDB 11.0–11.4; this file targets GraphDB 11.4.2.
#
# NO RULESET (graphdb:ruleset "empty" below): inference is DISABLED for this
# repository per architecture decision D2 (see openspec/changes/
# bootstrap-graph-infra/design.md). Reasons:
#   - staging isolation: the core-dataset client (internal/graph.Select)
#     enforces the core/staging boundary at the named-graph level; inferred
#     triples would blur what's asserted vs. derived and could leak across
#     that boundary in ways the client's FROM/FROM NAMED contract can't see
#   - traceability: every triple in the store is then something a loader or
#     the review/promotion flow actually wrote, not materialized by the
#     reasoner
#   - low payoff for this POC's query patterns
# Inference is fixed at repository creation — this config is POSTed once by
# the bootstrap/repo-ensure step (check-then-create, idempotent). Enabling
# inference later means recreating the repository from a new config, which is
# deliberate (see design.md D2 and the "Ruleset is fixed at repo creation"
# risk note).
#
# SHACL (sail-shacl: block below) — added by openspec/changes/
# shacl-validation/design.md D1. GraphDB's SHACL support is a *wrapping sail*
# that is fixed at repository-creation time: you cannot enable it on an
# already-existing repository (confirmed against the GraphDB SHACL docs), so
# it must be baked into this vendored config, not toggled at runtime. The
# wrapper (`sail:sailType "rdf4j:ShaclSail"`) sits above the original
# `graphdb:Sail` sail, which is preserved verbatim (byte-for-byte parameters,
# including `graphdb:ruleset "empty"`) under `sail:delegate [ … ]` — so
# inference stays OFF (D2) exactly as before; SHACL only adds write-time
# validation, it does not change what gets materialized. Key params:
#   - validationEnabled true            — turn SHACL on for this repo
#   - shapesGraph <...#SHACLShapeGraph> — RDF4J's reserved shapes graph;
#     `ensure-repo.sh` loads the shape catalogue there after the repo exists
#   - parallelValidation / serializableValidation — GraphDB defaults for
#     correctness under concurrent transactions
#   - logValidationViolations true      — violations are logged server-side,
#     feeding legible rejection reports (design.md D5)
#   - undefinedTargetValidatesAllSubjects false — shapes with no explicit
#     target do not implicitly validate every subject in the repo
#   - rdfsSubClassReasoning false        — consistent with inference-off (D2);
#     shape targets are concrete asserted classes, not inferred subclasses
#   - transactionalValidationLimit 500000 — our batches are far below this,
#     so every real write uses the cheap per-transaction validation path
#     (design.md D6), not whole-repository validation
# As with the rest of this file, the SHACL config is fixed at repo creation:
# a repository created from the old (non-wrapped) config is not SHACL-
# enabled and must be recreated (see D7 / ensure-repo.sh's pre-SHACL check,
# and the migration plan: `docker compose down -v` to drop `graphdb-data`,
# then `make up`).
#
# Sail-type literal confirmed against a live GraphDB 11.4.2 instance
# (shacl-validation task 1.2, throwaway "shacl_roundtrip" repo,
# create-then-download-config round-trip): GraphDB rejects the design doc's
# guessed `"graphdb:ShaclSail"` with HTTP 400 "Unsupported Sail type:
# graphdb:ShaclSail" and only accepts `"rdf4j:ShaclSail"` (used below). All
# `sail-shacl:` property names below (validationEnabled, shapesGraph,
# parallelValidation, serializableValidation, logValidationViolations,
# rdfsSubClassReasoning, transactionalValidationLimit) were verified to
# round-trip unchanged in the downloaded config.
#
# Consumed by: the `make up` repo-bootstrap step, which POSTs this file to
# GraphDB's REST API (POST /rest/repositories, multipart/form-data field
# "config") and is referenced from docker-compose.yml.
#
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix rep: <http://www.openrdf.org/config/repository#>.
@prefix sr: <http://www.openrdf.org/config/repository/sail#>.
@prefix sail: <http://www.openrdf.org/config/sail#>.
@prefix sail-shacl: <http://rdf4j.org/config/sail/shacl#>.
@prefix graphdb: <http://www.ontotext.com/config/graphdb#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

[] a rep:Repository ;
    rep:repositoryID "msr" ;
    rdfs:label "MSR knowledge graph (inference disabled — see D2; SHACL-enabled — see shacl-validation D1)" ;
    rep:repositoryImpl [
        rep:repositoryType "graphdb:SailRepository" ;
        sr:sailImpl [
            sail:sailType "rdf4j:ShaclSail" ;

            # SHACL validation parameters (shacl-validation D1). Shapes are
            # loaded into the reserved graph below by ensure-repo.sh, after
            # the repo exists (D2 of shacl-validation).
            sail-shacl:validationEnabled true ;
            sail-shacl:shapesGraph <http://rdf4j.org/schema/rdf4j#SHACLShapeGraph> ;
            sail-shacl:parallelValidation true ;
            sail-shacl:serializableValidation true ;
            sail-shacl:logValidationViolations true ;
            sail-shacl:undefinedTargetValidatesAllSubjects false ;
            sail-shacl:rdfsSubClassReasoning false ;
            sail-shacl:transactionalValidationLimit "500000"^^xsd:long ;

            # Delegate sail — the original (pre-SHACL) graphdb:Sail config,
            # preserved verbatim so inference stays off (D2) and all other
            # repository behavior is unchanged.
            sail:delegate [
                sail:sailType "graphdb:Sail" ;

                graphdb:read-only "false" ;

                # Inference and Validation — NO RULESET (D2)
                graphdb:ruleset "empty" ;
                graphdb:disable-sameAs "true" ;
                graphdb:check-for-inconsistencies "false" ;

                # Indexing
                graphdb:entity-id-size "32" ;
                graphdb:enable-context-index "false" ;
                graphdb:enablePredicateList "true" ;
                graphdb:enable-fts-index "false" ;
                graphdb:fts-indexes ("default" "iri") ;
                graphdb:fts-string-literals-index "default" ;
                graphdb:fts-iris-index "none" ;

                # Queries and Updates
                graphdb:query-timeout "0" ;
                graphdb:throw-QueryEvaluationException-on-timeout "false" ;
                graphdb:query-limit-results "0" ;

                # Settable in the file but otherwise hidden in the UI and in the RDF4J console
                graphdb:base-URL "http://example.org/owlim#" ;
                graphdb:defaultNS "" ;
                graphdb:imports "" ;
                graphdb:repository-type "file-repository" ;
                graphdb:storage-folder "storage" ;
                graphdb:entity-index-size "10000000" ;
                graphdb:in-memory-literal-properties "true" ;
                graphdb:enable-literal-index "true" ;
            ]
        ]
    ].
